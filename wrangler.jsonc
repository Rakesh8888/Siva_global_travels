{
  // Cloudflare Worker + static website deployment configuration
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "siva-global-travels",
  "main": "./worker.js",
  "compatibility_date": "2026-10-06",
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
